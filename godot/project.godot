; Element Guardians — Godot 4.4.1 starter skeleton; gameplay is NOT implemented.
config_version=5

[application]
config/name="Element Guardians｜元素守卫（骨架）"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
